---
---
<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Cybersecurity Reports Portfolio</title>
		<meta name="description" content="Portfolio website showcasing cybersecurity reports" />
		<meta property="og:title" content="Cybersecurity Reports Portfolio" />
		<meta property="og:description" content="Portfolio website showcasing cybersecurity reports" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
	</head>
	<body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-300">
		<div class="min-h-screen flex flex-col">
			<nav class="bg-white dark:bg-gray-800 shadow-sm border-b border-gray-200 dark:border-gray-700">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between h-16">
						<div class="flex">
							<div class="flex-shrink-0 flex items-center">
								<a href="/" class="text-xl font-bold text-primary-600 hover:text-primary-800 dark:text-primary-400 dark:hover:text-primary-300">
									CyberSec Portfolio
								</a>
							</div>
							<div class="hidden md:block">
								<div class="ml-10 flex items-baseline space-x-4">
									<a href="/"
										class="px-3 pt-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:hover:text-gray-400 border-b-2 border-transparent"
									>
										Home
									</a>
									<a href="/reports"
										class="px-3 pt-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:hover:text-gray-400 border-b-2 border-transparent"
									>
										Reports
									</a>
									<a href="#contact"
										class="px-3 pt-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:hover:text-gray-400 border-b-2 border-transparent"
									>
										Contact
									</a>
								</div>
							</div>
						</div>
						<div class="hidden md:block">
							<div class="ml-10 flex items-baseline space-x-4">
								<button id="dark-mode-toggle" class="p-2 rounded-md hover:bg-gray-200 dark:hover:bg-gray-700" aria-label="Toggle dark mode">
									<svg class="w-6 h-6 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
									</svg>
									<svg class="w-6 h-6 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
									</svg>
								</button>
							</div>
						</div>
					</div>
				</div>
			</nav>
			<main class="flex-grow container mx-auto px-4 py-8">
				<slot />
			</main>
			<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
					<div class="flex flex-col items-center sm:flex-row sm:justify-between">
						<span class="text-sm text-gray-500 dark:text-gray-400">
							© 2026 Cybersecurity Portfolio. All rights reserved.
						</span>
						<div class="flex space-x-4 mt-4 sm:mt-0">
							<a href="https://github.com" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">GitHub</a>
							<a href="https://linkedin.com" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">LinkedIn</a>
						</div>
					</div>
				</div>
			</footer>
		</div>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const toggleBtn = document.getElementById('dark-mode-toggle');
				if (toggleBtn) {
					toggleBtn.addEventListener('click', () => {
						document.documentElement.classList.toggle('dark');
						if (document.documentElement.classList.contains('dark')) {
							localStorage.setItem('theme', 'dark');
						} else {
							localStorage.setItem('theme', 'light');
						}
					});
				}

				// Check for saved theme preference or detect OS preference
				const savedTheme = localStorage.getItem('theme');
				if (savedTheme) {
					document.documentElement.classList[savedTheme === 'dark' ? 'add' : 'remove']('dark');
				} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.classList.add('dark');
				}
			});
		</script>
	</body>
</html>