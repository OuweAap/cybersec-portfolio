					<div class="ml-10 flex items-baseline space-x-4">
						<a href="/"
							class:list={["border-b-2 border-transparent border-primary-500", Astro.pathname === "/"]}
							class="px-3 pt-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:hover:text-gray-400"
						>
							Home
						</a>
						<a href="/reports"
							class:list={["border-b-2 border-transparent border-primary-500", Astro.pathname.startsWith("/reports") && !Astro.pathname.startsWith("/reports/")]}
							class="px-3 pt-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:hover:text-gray-400"
						>
							Reports
						</a>
						<a href="/#contact"
							class:list={["border-b-2 border-transparent border-primary-500", Astro.pathname.includes("#contact")]}
							class="px-3 pt-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 dark:hover:text-gray-400"
