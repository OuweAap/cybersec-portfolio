<article class="report-card border rounded-lg p-6 hover:shadow-lg transition-shadow">
	<h2 class="text-xl font-semibold mb-2">
		<a href={`/reports/${slug}`} class="text-primary-600 hover:text-primary-800">{title}</a>
	</h2>
	<p class="text-gray-600 text-sm mb-4">{summary}</p>
	<div class="flex flex-wrap gap-2">
		{#each tags as tag}
			<span class="tag text-xs px-2 py-1 rounded bg-primary-100 dark:bg-primary-900 text-primary-800">{tag}</span>
		{/each}
	</div>
	<p class="text-xs text-gray-500 mt-2">{date}</p>
</article>