import { getCollection } from 'astro:content';
import ReportCard from '../components/ReportCard.astro';

const reports = await getCollection('reports', ({ data }) => !data.redacted);
const featured = reports.slice(0, 3);
---
<section class="py-16">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-bold text-center mb-12">Featured Reports</h2>
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
			{featured.map((report) => (
				<ReportCard 
					title={report.data.title}
					date={report.data.date}
					summary={report.data.summary}
					tags={report.data.tags}
					slug={report.slug}
					redacted={report.data.redacted}
				/>
			))}
		</div>
	</div>
</section>