<form 
	action="https://formspree.io/f/YOUR_FORM_ID" 
	method="POST"
	class="max-w-2xl mx-auto space-y-6"
	data-testid="contact-form"
>
	<input type="hidden" name="_subject" value="New Portfolio Contact" />
	<input type="hidden" name="_template" value="table" />

	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div>
			<label for="name" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Name</label>
			<input 
				type="text" 
				id="name" 
				name="name" 
				required
				class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:focus:border-primary-400 dark:bg-gray-800 dark:text-gray-100"
			/>
		</div>

		<div>
			<label for="email" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Email</label>
			<input 
				type="email" 
				id="email" 
				name="email" 
				required
				class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:focus:border-primary-400 dark:bg-gray-800 dark:text-gray-100"
			/>
		</div>
	</div>

	<div>
		<label for="message" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Message</label>
		<textarea 
			id="message" 
			name="message" 
			rows="4" 
			required
			class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:focus:border-primary-400 dark:bg-gray-800 dark:text-gray-100"
		></textarea>
	</div>

	<button 
		type="submit" 
		class="btn btn-primary w-full px-6 py-3 text-lg"
		data-testid="submit-button"
	>
		Send Message
	</button>
</form>